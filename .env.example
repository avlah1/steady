# Copy to .env and fill in. Never commit .env.

# Shared secret the vision worker sends in the X-API-Key header.
API_KEY=change-me

# Demo timer durations (seconds).
REPLY_TIMEOUT_S=10
ACK_TIMEOUT_S=30

# Max seconds to classify a reply before treating it as "unclear".
CLASSIFY_TIMEOUT_S=5

# Browser origins allowed to call the API (the dashboard's dev server URL), comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
